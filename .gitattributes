# Normalize line endings in the repository, use CRLF in Windows working copies
* text=auto

*.cs       text eol=crlf
*.ps1      text eol=crlf
*.manifest text eol=crlf
*.md       text eol=crlf
*.txt      text eol=crlf
*.py       text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary
*.zip binary
*.7z  binary
